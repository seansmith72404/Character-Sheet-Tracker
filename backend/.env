# 1. Your Database Connection (The big secret)
# Replace the bracketed info with your actual Neon credentials
DATABASE_URL=""
# 2. Your Server Configuration
# The port your local Node server will run on
PORT=3000

# 3. Environment Declaration
# Helps Express and other packages know you are in testing mode
NODE_ENV=development

# 4. Authentication Secrets (You will likely need this very soon!)
# Used to sign login tokens after a user successfully enters their password
JWT_SECRET=""
